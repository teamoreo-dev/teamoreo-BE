PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/team_oreo
# Generate a random secret with at least 32 characters; never use this placeholder.
JWT_SECRET=
# Positive integer seconds, or integer with s/m/h/d/w suffix (maximum 24 days).
JWT_EXPIRES_IN=2h
# Comma-separated exact origins; no paths, wildcards or trailing slashes.
CLIENT_ORIGIN=http://localhost:3002
# lax for local/related sites; none for separate production sites (requires HTTPS).
COOKIE_SAME_SITE=lax
# Set only behind a known proxy topology, e.g. 1 for one trusted reverse proxy.
# TRUST_PROXY=1
ADMIN_NAME=Team Oreo Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
